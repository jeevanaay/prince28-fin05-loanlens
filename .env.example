
# Copy this file to .env and fill in real values.
# Never commit .env or put database passwords in this file.

APP_NAME=loanlens
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Replace this placeholder only in your local .env file.
DATABASE_URL=postgresql://localhost:5432/loanlens
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30.0
USD_INR=95.0
# Queue and worker (Day 10). On your laptop Redis comes from: docker compose up -d redis
REDIS_URL=redis://localhost:6379
# Whoever sends this value in the X-Admin-Token header may start an ingestion. Long and random.
ADMIN_TOKEN=
# true only where there is no separate worker service (Render free): the API runs the worker.
WORKER_IN_API=false

# Ingestion configuration
MANIFEST_FILE=data/manifest.jsonl
INGEST_CONCURRENCY=2
INGEST_RPM=12.0
INGEST_JOB_TIMEOUT=60
INGEST_MAX_TRIES=3
