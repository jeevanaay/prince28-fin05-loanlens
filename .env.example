
# Copy this file to .env and fill in real values.
# Never commit .env or put database passwords in this file.

APP_NAME=loanlens
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Replace this placeholder only in your local .env file.
DATABASE_URL=postgresql://localhost:5432/loanlens
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30.0
USD_INR=95.0
